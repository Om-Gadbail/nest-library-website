# Nest Library — environment variables (production)
# Copy to `.env` for local development. Never commit real secrets.
# Only VITE_-prefixed variables are exposed to the browser.

# Production site URL, e.g. https://www.nestlibrary.in
# (empty = canonical tags omitted; set before launch for SEO).
VITE_SITE_URL=

# Public WhatsApp number in international format without `+`.
# Verified Nest number default: 917038201884 (central config fallback).
# Override only if the number changes.
VITE_WHATSAPP_NUMBER=

# Public phone number as displayed/to be dialled.
VITE_PHONE_NUMBER=

# Public contact email (empty = email CTAs hidden).
VITE_EMAIL=

# Shareable Google Maps embed URL for the verified address (no API key needed).
# Empty = honest location-card state, no fake map.
VITE_GOOGLE_MAPS_URL=

# Shareable Google Directions URL for the verified address.
# Empty = directions buttons hidden (no dead buttons).
VITE_GOOGLE_DIRECTIONS_URL=

# Shared backend base URL (api client appends /api/leads/* itself, so no path suffix).
# Local: http://localhost:8000 — Production, e.g. https://api.nestlibrary.in
# Empty = BACKEND-READY mode (device outbox + WhatsApp handoff).
# See docs/LEAD_API.md for the exact contract to implement.
VITE_API_BASE_URL=

# Analytics measurement ID (provider connected later; empty = disabled).
VITE_ANALYTICS_ID=
