# Nest Library — environment variables (foundation)
# Copy to `.env` for local development. Never commit real secrets.
# Only VITE_-prefixed variables are exposed to the browser.

# Production site URL (leave empty until the domain is configured).
VITE_SITE_URL=

# Public WhatsApp number in international format without `+` (e.g. 919999999999).
# Leave empty until the verified business number is known.
VITE_WHATSAPP_NUMBER=

# Public phone number as displayed/to be dialled (e.g. +91 99999 99999).
VITE_PHONE_NUMBER=

# Public contact email.
VITE_EMAIL=

# Shareable Google Maps URL for the verified address (no API key needed).
VITE_GOOGLE_MAPS_URL=

# Shareable Google Directions URL for the verified address.
VITE_GOOGLE_DIRECTIONS_URL=

# Analytics measurement ID (provider connected later; empty = disabled).
VITE_ANALYTICS_ID=
